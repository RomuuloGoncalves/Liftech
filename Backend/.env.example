MONGODB_USERNAME="username"
MONGODB_PASSWORD="password"
MONGODB_URI="uri"
MONGODB_NAME="dbname"

# Fila de Mensagens / Telemetria (RabbitMQ / CloudAMQP)
# URL de conexão AMQP (ex.: amqps://usuario:senha@host.cloudamqp.com/vhost). Se omitida, a API sobe sem consumidor da fila.
RABBITMQ_URL="amqps://usuario:senha@host.cloudamqp.com/vhost"
# Prefixo opcional para filas e chaves no broker (padrão vazio: ""); use para isolar filas se dev e prod compartilharem o mesmo broker.
RABBITMQ_PREFIXO=""

AMBIENTE='x'

# Render keep-alive
KEEP_ALIVE_URL='ping address'
KEEP_ALIVE_INTERVAL_MINUTES='ping interval'

# Acessos fixos do seed: admin@admin.com / asdasdasd e colaborador@colaborador.com / asdasdasd
# GET /api/reset (público) apaga o banco e roda o seed do zero.

# Autenticação
JWT_SECRET='segredo-forte'
JWT_EXPIRES_IN='8h'
